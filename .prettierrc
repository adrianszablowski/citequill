{
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "tabWidth": 4,
    "printWidth": 80,
    "arrowParens": "always",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./app/globals.css",
    "tailwindFunctions": ["cn", "cva"]
}
