{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node --no-warnings $CLAUDE_PROJECT_DIR/.claude/hooks/rules-for-path.mjs",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard.mjs",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.sh",
                        "timeout": 300
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.sh",
                        "timeout": 300
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(pnpm type-check *)",
            "Bash(pnpm lint *)",
            "Bash(pnpm format *)",
            "Bash(pnpm format:check *)",
            "Bash(pnpm verify *)",
            "Bash(pnpm verify:deep *)",
            "Bash(pnpm build *)",
            "Bash(pnpm install *)",
            "Bash(pnpm add *)",
            "Bash(pnpm view *)",
            "Bash(pnpm why *)",
            "Bash(npm view *)",
            "Bash(git check-ignore *)",
            "Bash(git ls-tree *)"
        ]
    }
}
