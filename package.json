{
    "name": "citequill",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "type-check": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "verify": "pnpm type-check && pnpm lint && pnpm format:check",
        "verify:deep": "pnpm verify && pnpm build",
        "lint:fix": "eslint . --max-warnings 0 --fix && prettier --write ."
    },
    "dependencies": {
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "packageManager": "pnpm@10.33.0"
}
