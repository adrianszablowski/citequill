{
    "name": "citequill",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "type-check": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "verify": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test",
        "verify:deep": "pnpm verify && pnpm build",
        "lint:fix": "eslint . --max-warnings 0 --fix && prettier --write .",
        "db:types": "supabase gen types typescript --linked --schema public > lib/types/database.ts && prettier --write lib/types/database.ts",
        "schema:types": "node scripts/schema-org-types.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.135.0",
        "@base-ui/react": "^1.9.0",
        "@hookform/resolvers": "^5.9.1",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.118.0",
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "fast-xml-parser": "^5.11.2",
        "image-size": "^2.0.4",
        "lucide-react": "^1.57.0",
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.90.0",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "robots-parser": "^3.0.1",
        "server-only": "^0.0.1",
        "shadcn": "^4.21.5",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2",
        "tw-animate-css": "^1.4.0",
        "unified": "^11.0.5",
        "workflow": "^5.2.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/turbopack": "^4",
        "@tailwindcss/typography": "^0.5.20",
        "@types/hast": "^3.0.5",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/turndown": "^5.0.6",
        "babel-plugin-react-compiler": "^1.0.0",
        "domhandler": "5.0.3",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-better-tailwindcss": "^4.9.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@10.33.0"
}
